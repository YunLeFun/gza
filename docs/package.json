{
  "name": "@yunlefun/dayun-kicker-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "node ../scripts/media-assets.mjs && vitepress dev --host 127.0.0.1",
    "build": "node ../scripts/check-docs-model-media.mjs && node ../scripts/check-model-catalog.mjs && node ../scripts/check-weapon-preview.mjs && node ../scripts/media-assets.mjs && node ../scripts/check-docs-inputs.mjs && vitepress build",
    "preview": "vitepress preview --host 127.0.0.1",
    "typecheck": "node ../scripts/media-assets.mjs && vue-tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/three": "^0.186.0",
    "typescript": "^6.0.3",
    "vitepress": "1.6.4",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.12"
  },
  "dependencies": {
    "reka-ui": "2.11.0",
    "three": "^0.186.1"
  }
}
